# ==============================================================================
# ReadyCheck AI — Environment Configuration Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production keys to source control.
# ==============================================================================

# --- Client-Side Configuration (Publicly Exposed via NEXT_PUBLIC_) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase Server Administration (Server-Only Secret) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Google Gemini AI API Key (Server-Only Secret) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Upstash Redis (Rate Limiting & Caching - Server-Only) ---
# Optional in local dev; system falls back to in-memory store if omitted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Razorpay Payment Gateway (Server-Only) ---
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Set to true for local testing without charging actual cards; must be false in production
RAZORPAY_DEMO_MODE=true

# --- Cryptographic Certificate Verification (Optional Server-Only ECDSA / RSA Keys) ---
# If omitted, certificate verification falls back to cryptographic HMAC checksums
CERTIFICATE_PRIVATE_KEY=
CERTIFICATE_PUBLIC_KEY=

# --- Observability & Logging (Optional) ---
LOG_LEVEL=info
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
